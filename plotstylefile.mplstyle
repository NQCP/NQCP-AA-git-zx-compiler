figure.facecolor: white
figure.edgecolor: black

font.size: 10.0

axes.facecolor: white
axes.edgecolor: black
axes.linewidth: 0.8
axes.grid: True
axes.labelsize: 8.0
axes.titlesize: 10.0
axes.labelcolor: black

xtick.labelsize: 8.0
xtick.color: black
xtick.direction: out

ytick.labelsize: 8.0
ytick.color: black
ytick.direction: out

grid.color: black
grid.alpha: 0.3
grid.linestyle: -
grid.linewidth: 0.8

lines.linewidth: 0.8
lines.markersize: 4

legend.fontsize: 8.0
legend.title_fontsize: 8
legend.frameon: True
legend.framealpha: 0.9
