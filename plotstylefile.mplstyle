figure.facecolor: white
figure.edgecolor: black

font.size: 18.0

axes.facecolor: white
axes.edgecolor: black
axes.linewidth: 0.8
axes.grid: True
axes.labelsize: 18.0
axes.titlesize: 18.0
axes.labelcolor: black

xtick.labelsize: 18.0
xtick.color: black
xtick.direction: out

ytick.labelsize: 18.0
ytick.color: black
ytick.direction: out

grid.color: black
grid.alpha: 0.3
grid.linestyle: -
grid.linewidth: 0.8

lines.linewidth: 1.5
lines.markersize: 6

legend.fontsize: 18.0
legend.frameon: True
legend.framealpha: 0.9
